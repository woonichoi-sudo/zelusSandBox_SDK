# 회사 저장소 — 별개 git repo. 읽기 전용이며 이 저장소에 포함하지 않는다.
zelusSandBox_Cobalt/

# Claude Code 로컬 설정
.claude/settings.local.json

# ── C++ / CMake ──────────────────────────────
build/
build-*/
engine-build/
cmake-build*/
out/

# vcpkg 의존성 설치 트리 (우리 전용. 저장소 원본과 별개)
vcpkg_installed/

# ★ 우리가 패치한 vcpkg 체크아웃. 빌드 툴체인이 이것을 가리킨다 —
#   지우면 재구성이 깨지고, 다시 만들려면 아래 두 단계를 되풀이해야 한다:
#     ① 저장소의 vcpkg 서브모듈을 여기로 복제 (고정 커밋 acffd1489 유지)
#     ② `scripts/cmake/vcpkg_acquire_msys.cmake` 의 **패키지 선언 매크로만**
#        최신 vcpkg 것으로 갈아 끼운다 (옛 1~266행 + 새 266행~끝).
#   왜 필요한지는 CLAUDE.md 참고 — 고정 기준점(2025-03)이 물고 있는 MSYS2
#   파일들이 인터넷에서 사라져서 404 가 난다.
vcpkg-pinned/
*.obj
*.lib
*.exp
*.pdb
*.ilk

# ── Go ───────────────────────────────────────
*.exe
*.exe~
*.test
vendor/

# ── Node / TypeScript ────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo

# 런타임 데이터 — 업로드된 씬(.zls)과 익스포트 산출물.
# sample.zls 한 건이 103MB다. 절대 커밋되면 안 된다.
backend/data/

# UI 검증 하네스(`npm run verify:ui`)가 남기는 스크린샷.
# 실행마다 통째로 지우고 다시 만든다. 실패 원인을 눈으로 볼 때만 쓰는 산출물이라
# 저장소에 들어갈 이유가 없다.
frontend/verify-out/

# 시크릿 — 공개 저장소라 한 번 올라가면 히스토리에 영원히 남는다.
# 예시 값은 .env.example 로 만들어 커밋할 것(아래에서 예외 처리).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*credentials*
*secret*

# 실행 로그
*.log
npm-debug.log*
yarn-error.log*
coverage/

# 네이티브 산출물 — SDK/DLL 은 회사 자산이라 재배포하지 않는다.
*.dll
*.so
*.dylib

# 씬·시뮬 데이터. backend/data 밖에 흘린 것까지 막는다.
*.zls
*.zbin
*.zsgltf

# ── 에디터 / OS ──────────────────────────────
.vs/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
.claude/settings.json.tmp.*
