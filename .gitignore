# 회사 저장소 — 별개 git repo. 읽기 전용이며 이 저장소에 포함하지 않는다.
zelusSandBox_Cobalt/

# Claude Code 로컬 설정
.claude/settings.local.json

# ── C++ / CMake ──────────────────────────────
build/
build-*/
engine-build/
cmake-build*/
out/

# vcpkg 의존성 설치 트리 (우리 전용. 저장소 원본과 별개)
vcpkg_installed/
*.obj
*.lib
*.exp
*.pdb
*.ilk

# ── Go ───────────────────────────────────────
*.exe
*.exe~
*.test
vendor/

# ── Node / TypeScript ────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo

# 런타임 데이터 — 업로드된 씬(.zls)과 익스포트 산출물.
# sample.zls 한 건이 103MB다. 절대 커밋되면 안 된다.
backend/data/

# UI 검증 하네스(`npm run verify:ui`)가 남기는 스크린샷.
# 실행마다 통째로 지우고 다시 만든다. 실패 원인을 눈으로 볼 때만 쓰는 산출물이라
# 저장소에 들어갈 이유가 없다.
frontend/verify-out/

# 시크릿 — 공개 저장소라 한 번 올라가면 히스토리에 영원히 남는다.
# 예시 값은 .env.example 로 만들어 커밋할 것(아래에서 예외 처리).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*credentials*
*secret*

# 실행 로그
*.log
npm-debug.log*
yarn-error.log*
coverage/

# 네이티브 산출물 — SDK/DLL 은 회사 자산이라 재배포하지 않는다.
*.dll
*.so
*.dylib

# 씬·시뮬 데이터. backend/data 밖에 흘린 것까지 막는다.
*.zls
*.zbin
*.zsgltf

# ── 에디터 / OS ──────────────────────────────
.vs/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
.claude/settings.json.tmp.*
